{
  "name": "khanthman-prediction-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-reporter=spec --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:integration",
    "db:migrate": "node --import tsx src/db/cli.ts migrate",
    "db:seed": "node --import tsx src/db/cli.ts seed",
    "dev:pglite": "node scripts/dev-pglite.mjs",
    "test:postgres": "node --import tsx --test --test-reporter=spec --test-concurrency=1 \"tests/integration/postgres-concurrency.test.ts\"",
    "test:full": "npm run test && npm run test:integration && npm run test:postgres",
    "db:cleanup-idempotency": "node --import tsx src/db/cli.ts cleanup-idempotency",
    "db:reconcile": "node --import tsx src/db/cli.ts reconcile",
    "test:postgres:gate": "node --import tsx scripts/postgres-gate.ts",
    "verify:postgres-gate": "node scripts/verify-postgres-gate.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-myanmar": "^5.2.6",
    "@next/env": "^15.5.29",
    "next": "^15.5.6",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
