# Khant Hman environment configuration.
# Copy to .env.local for local development. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Production / staging: a PostgreSQL connection string. TLS is expected for any
# non-local host. Example:
# DATABASE_URL=postgres://khanthman:password@127.0.0.1:5432/khanthman
DATABASE_URL=

# Local demo mode (embedded PostgreSQL in WASM, no external service).
# Set KHANTHMAN_DB=pglite (and leave DATABASE_URL empty) for `npm run dev:pglite`.
KHANTHMAN_DB=
# Default PGlite data directory for new setups.
KHANTHMAN_PGLITE_DIR=./.data/khanthman

# --- Deprecated legacy variables (still honored) ---------------------------
# The product was previously branded "Mingala". The old variables keep working
# for existing local development setups; they are deprecated and will be
# removed in a future release. Precedence, highest first:
#   KHANTHMAN_DB            > MINGALA_DB
#   KHANTHMAN_PGLITE_DIR    > MINGALA_PGLITE_DIR
# When NO directory variable is set, an existing ./.data/mingala directory is
# reused automatically, so existing local development data is never silently
# abandoned in favor of an empty ./.data/khanthman database.
# MINGALA_DB=pglite
# MINGALA_PGLITE_DIR=./.data/mingala

# Connection pool size for the pg driver.
DATABASE_POOL_MAX=10

# --- Client address trust (rate limiting) ---------------------------------
# Forwarded IP headers are honored ONLY when the immediate TCP peer is explicitly
# trusted. The peer is captured from the Node socket by instrumentation.ts; it is
# never read from a client-supplied header.
#
# Comma-separated IP literals or CIDRs of proxies allowed to connect directly to
# this process. Empty (default) trusts no proxy. Wildcards (0.0.0.0/0, ::/0) and
# malformed entries fail closed. Example for a local nginx/Caddy/Traefik:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
#
# Number of trusted proxies between the client and this process.
#   0 (default)  No forwarded-header trust. Direct connections are bucketed by
#                their captured socket address when available; otherwise all
#                callers share one bucket. Safe, coarse.
#   1            One trusted proxy. The client address is read from the RIGHT of
#                X-Forwarded-For, so client-supplied entries on the left cannot
#                influence it.
#   n            n trusted proxies, read n positions from the right. The proxy
#                entries to the right of the client must also be allowlisted.
#
# Leave at 0 unless you know your proxy topology and have set TRUSTED_PROXY_CIDRS.
TRUSTED_PROXY_HOPS=0

# Optional: a single header your edge overwrites wholesale (Vercel sets
# x-vercel-forwarded-for; Cloudflare sets cf-connecting-ip). It is honored only
# when the immediate peer is in TRUSTED_PROXY_CIDRS. X-Forwarded-For is rejected.
# TRUSTED_CLIENT_IP_HEADER=
