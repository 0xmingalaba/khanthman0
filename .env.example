# Mingala environment configuration.
# Copy to .env.local for local development. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Production / staging: a PostgreSQL connection string. TLS is expected for any
# non-local host. Example:
# DATABASE_URL=postgres://mingala:password@127.0.0.1:5432/mingala
DATABASE_URL=

# Local demo mode (embedded PostgreSQL in WASM, no external service).
# Set MINGALA_DB=pglite (and leave DATABASE_URL empty) for `npm run dev:pglite`.
MINGALA_DB=
MINGALA_PGLITE_DIR=./.data/mingala

# Connection pool size for the pg driver.
DATABASE_POOL_MAX=10

# --- Client address trust (rate limiting) ---------------------------------
# The app cannot see the TCP peer address, so it must be told how many proxies
# you control in front of it. Trusting the client-supplied X-Forwarded-For
# leftmost entry is a rate-limit bypass; this setting is how that is avoided.
#
#   0 (default)  No proxy you control. Forwarding headers are IGNORED and all
#                callers share one rate-limit bucket. Safe, coarse.
#   1            One proxy (Vercel, a load balancer, nginx). The client address
#                is read from the RIGHT of X-Forwarded-For, so client-supplied
#                entries on the left cannot influence it.
#   n            n trusted proxies, read n positions from the right.
#
# Leave at 0 unless you know your proxy topology. A wrong value here either
# over-groups clients (n too low) or trusts an attacker-supplied entry (n too
# high relative to reality).
TRUSTED_PROXY_HOPS=0

# Optional: a single header your edge overwrites wholesale (Vercel sets
# x-vercel-forwarded-for; Cloudflare sets cf-connecting-ip). When set, this
# header is authoritative and X-Forwarded-For is ignored. Only set it if you
# are certain the edge strips any client-supplied value.
# TRUSTED_CLIENT_IP_HEADER=
